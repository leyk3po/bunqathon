# Leave VITE_API_BASE_URL empty so the frontend uses same-origin paths
# served by the vite dev proxy (locally) or Caddy (production).
# Override only if you intentionally hit the backend on a different host.
# Set VITE_PUBLIC_APP_URL when buyers scan QR codes from another device.
VITE_API_BASE_URL=
VITE_API_PREFIX=/api/v1
VITE_PUBLIC_APP_URL=
