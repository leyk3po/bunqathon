# Copy to .env and fill in values
# Never commit .env to git

# --- Database ---
POSTGRES_PASSWORD=flashdrop_dev

# --- bunq ---
BUNQ_API_KEY=your_sandbox_api_key_here
BUNQ_ENVIRONMENT=sandbox          # sandbox | production
BUNQ_MONETARY_ACCOUNT_ID=         # filled after bunq setup

# --- AWS ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
S3_BUCKET_NAME=flashdrop-media

# --- AI (multimodal generation) ---
AI_API_KEY=                        # Anthropic or OpenAI key

# --- Backend public URL (for bunq webhooks) ---
# Local dev: run infra/scripts/ngrok-dev.sh and paste the https URL here
# Production: your Lightsail container public domain
PUBLIC_BACKEND_URL=https://your-ngrok-or-lightsail-url.com
